knitr::opts_knit$set(root.dir = "C:/Users/edmun/Documents/2023-2026 - DPhil Politics/1 - THESIS/4 - PhD4 - Personality")
setwd("C:/Users/edmun/Documents/2023-2026 - DPhil Politics/1 - THESIS/4 - PhD4 - Personality")
meta = read.csv("1 - Analysis/META/meta.csv")
library(OpenMx)
library(umx)
library(haven)
library(foreign)
library(estimatr)
library(lme4)
library(fixest)
library(tidyverse)
library(stargazer)
library(eeptools)
library(modelsummary)
library(sjPlot)
library(ggplot2)
library(broom)
library(RColorBrewer)
library(psych)
library(ggh4x)
library(ggpubr)
set.seed(1234)
meta = meta %>%
mutate(t = eff.size/se,
partial = t/sqrt(I(t^2) + (n-control-1)),
partial.r = case_when(eff.metric == "r" ~ eff.size,
eff.metric == "b" ~ partial,
eff.metric == "taub" ~ 1.57*eff.size,
eff.metric == "l" ~ eff.size * sqrt(reliability.x*reliability.y)),
z = 0.5*log((1+partial.r)/(1-partial.r)),
eff.dir = ifelse(eff.size>0, "Positive", "Negative"),
)
table(meta$eff.dir, meta$b5.domain)
meta_agree = meta %>%
filter(b5.domain == "agree")
meta_neuro = meta %>%
filter(b5.domain == "neuro")
meta_consc = meta %>%
filter(b5.domain == "consc")
meta_extra = meta %>%
filter(b5.domain == "extra")
meta_openn = meta %>%
filter(b5.domain == "openn")
lm1 = lmer(z ~ 1 + (1|survey) + (1|measure.b5) + (1|measure.pol), data = meta_agree)
lm2 = lmer(z ~ 1 + (1|survey) + (1|measure.b5) + (1|measure.pol), data = meta_neuro)
lm3 = lmer(z ~ 1 + (1|survey) + (1|measure.b5) + (1|measure.pol), data = meta_consc)
lm4 = lmer(z ~ 1 + (1|survey) + (1|measure.b5) + (1|measure.pol), data = meta_extra)
lm5 = lmer(z ~ 1 + (1|survey) + (1|measure.b5) + (1|measure.pol), data = meta_openn)
length(unique(meta_agree$study.num))
length(unique(meta_neuro$study.num))
length(unique(meta_consc$study.num))
length(unique(meta_extra$study.num))
length(unique(meta_openn$study.num))
modelsummary(list(lm1, lm2, lm3, lm4, lm5), stars = T)
modelsummary(list(lm1, lm2, lm3, lm4, lm5), stars = T, out = "meta.html")
meta_nocontrols = meta %>%
mutate(t = eff.size/se,
partial = t/sqrt(I(t^2) + (n-control-1)),
partial.r = case_when(eff.metric == "r" ~ eff.size,
eff.metric == "b" ~ partial,
eff.metric == "taub" ~ 1.57*eff.size,
eff.metric == "l" ~ eff.size * sqrt(reliability.x*reliability.y)),
z = 0.5*log((1+partial.r)/(1-partial.r)),
eff.dir = ifelse(eff.size>0, "Positive", "Negative"),
) %>%
filter(control==0)
table(meta_nocontrols$eff.dir, meta_nocontrols$b5.domain)
meta_agree = meta_nocontrols %>%
filter(b5.domain == "agree")
meta_neuro = meta_nocontrols %>%
filter(b5.domain == "neuro")
meta_consc = meta_nocontrols %>%
filter(b5.domain == "consc")
meta_extra = meta_nocontrols %>%
filter(b5.domain == "extra")
meta_openn = meta_nocontrols %>%
filter(b5.domain == "openn")
lm1 = lmer(z ~ 1 + (1|survey) + (1|measure.b5) + (1|measure.pol), data = meta_agree)
lm2 = lmer(z ~ 1 + (1|survey) + (1|measure.b5) + (1|measure.pol), data = meta_neuro)
lm3 = lmer(z ~ 1 + (1|survey) + (1|measure.b5) + (1|measure.pol), data = meta_consc)
lm4 = lmer(z ~ 1 + (1|survey) + (1|measure.b5) + (1|measure.pol), data = meta_extra)
lm5 = lmer(z ~ 1 + (1|survey) + (1|measure.b5) + (1|measure.pol), data = meta_openn)
length(unique(meta_agree$study.num))
length(unique(meta_neuro$study.num))
length(unique(meta_consc$study.num))
length(unique(meta_extra$study.num))
length(unique(meta_openn$study.num))
modelsummary(list(lm1, lm2, lm3, lm4, lm5), stars = T)
modelsummary(list(lm1, lm2, lm3, lm4, lm5), stars = T, out = "meta.html")
